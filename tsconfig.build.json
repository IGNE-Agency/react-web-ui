{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"isolatedDeclarations": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src"],
	"exclude": [
		"src/**/*.stories.tsx",
		"src/**/*.mdx",
		"src/lib/storybook",
		"src/terrazzo",
		".storybook",
		"docs"
	],
	"references": []
}
