		"fix": "bun run tokens && oxfmt . && oxlint --fix .",
		"check": "bun run tokens && oxfmt --check . && oxlint . && bun tools/check-docs-tokens.ts",
		"tokens": "bun src/terrazzo/build-tokens.ts",
		"build": "bun run tokens && vite build && tsc -p tsconfig.build.json && tsc -p tsconfig.terrazzo.json",
		"check:exports": "bun tools/check-exports.ts",
		"prepack": "bun run build",
		"test": "bun run tokens && STORYBOOK_DISABLE_TELEMETRY=1 vitest run",
		"storybook": "bun run tokens && STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
		"storybook:build": "bun run tokens && STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
		"docs:links": "bun .storybook/docs-links/report.ts"
	},
